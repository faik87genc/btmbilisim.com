# .env.local'e kopyalayıp doldurun. Gerçek anahtarları bu dosyaya YAZMAYIN.

# --- İletişim formu (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_BCC_EMAIL=

# --- Neon Postgres ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Admin oturumu ---
SESSION_SECRET=
# npm run hash-password -- "sifreniz"
ADMIN_PASSWORD_HASH=
SESSION_VERSION=1

# --- Vercel Blob: PUBLIC erişimli store olmalı (private store put({access:"public"}) çağrısında hata verir) ---
BLOB_READ_WRITE_TOKEN=

# --- AI metin üretimi ---
BLOG_AI_PROVIDER=
BLOG_AI_MODEL=
BLOG_AI_EFFORT=
BLOG_AI_TARGET_SCORE=90
BLOG_AI_MAX_REPAIRS=1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- AI görsel üretimi ---
BLOG_IMAGE_PROVIDER=cloudflare
BLOG_IMAGE_MODEL=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Rate limiting (opsiyonel; boşsa bellek içi çalışır) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
